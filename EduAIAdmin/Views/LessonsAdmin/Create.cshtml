@model EduAIAdmin.Models.Lesson

@{
    ViewData["Title"] = "Thêm bài học";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var courses = ViewBag.Courses as List<EduAIAdmin.Models.Course>;
}

<div class="container-fluid">
    <h1 class="mt-4">Thêm bài học mới</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Home/Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/LessonsAdmin/Index">Bài học</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Thông tin bài học
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Nội dung</label>
                    <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label">Khóa học</label>
                    <select asp-for="CourseId" class="form-select">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.Id">@course.Title (@course.Subject.Name)</option>
                        }
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Order" class="form-label">Thứ tự</label>
                    <input asp-for="Order" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 