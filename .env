# Application URL
APP_URL=http://localhost/WEBSITE_EDUAI

# Database Configuration
DB_HOST=localhost
DB_NAME=eduai_blog
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/WEBSITE_EDUAI/backend/api/auth/google/callback

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost/WEBSITE_EDUAI/backend/api/auth/facebook/callback

# Callback URL
CALLBACK_URL=http://localhost/WEBSITE_EDUAI/backend/api/auth/google/callback.php

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password 
