RewriteEngine On
RewriteBase /WEBSITE_EDUAI/backend/

# Handle API requests
RewriteRule ^api/auth/google/?$ api/auth/google.php [L]
RewriteRule ^api/auth/google/callback/?$ api/auth/google/callback.php [L]

# Handle frontend requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L] 